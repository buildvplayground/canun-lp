# ══════════════════════════════════════════════════════
#  Canun Sistemas Construtivos — Apache config
# ══════════════════════════════════════════════════════
Options -Indexes

# Página principal: index.html primeiro, index.php como fallback
DirectoryIndex index.html index.php

# ── Headers de segurança ─────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    Header always unset X-XSS-Protection
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # ── Content-Security-Policy (modo REPORT-ONLY) ───────
    # Não bloqueia nada ainda: só relata violações no console do navegador.
    # Depois de validar por alguns dias que nenhum pixel/tag quebrou,
    # troque "Content-Security-Policy-Report-Only" por "Content-Security-Policy"
    # para ativar o bloqueio real.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.google.com https://*.googleadservices.com https://*.googlesyndication.com https://*.doubleclick.net https://adservice.google.com https://connect.facebook.net https://*.clarity.ms https://snap.licdn.com https://*.gomerlin.com.br https://*.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.gomerlin.com.br; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.google.com https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.googleadservices.com https://connect.facebook.net https://www.facebook.com https://*.clarity.ms https://px.ads.linkedin.com https://*.gomerlin.com.br; frame-src 'self' https://*.googletagmanager.com https://*.doubleclick.net https://*.youtube.com https://www.facebook.com https://*.gomerlin.com.br; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ── Protege arquivos sensíveis ───────────────────────
<FilesMatch "^(db-config\.php|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS — ativar após instalar certificado SSL
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bloqueia PHP em uploads
    RewriteRule ^uploads/.*\.(php|php5|phtml)$ - [F,L]

    # Garante trailing slash nos slugs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(woodframe|cabanas|comercial)$ /$1/ [R=301,L]
</IfModule>

# ── Compressão Gzip ──────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ── Cache de assets estáticos ─────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp             "access plus 3 months"
    ExpiresByType image/png              "access plus 3 months"
    ExpiresByType text/css               "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
